{
  "name": "software-periodic-table",
  "version": "0.6.0",
  "description": "A finite ontology of 115 recurring software elements and a composition framework for LLM-based coding agents",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc",
    "example": "tsx examples/task-board.ts",
    "example:crm": "tsx examples/crm-contacts.ts",
    "example:product": "tsx examples/product-catalog.ts",
    "example:invoice": "tsx examples/invoice-dashboard.ts",
    "eval": "tsx eval/runner.ts",
    "eval:agent": "tsx eval/agent-eval.ts",
    "validate": "tsx scripts/validate-ontology.ts",
    "coverage": "tsx scripts/coverage.ts",
    "search": "tsx scripts/search.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.examples.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "format": "biome check --write",
    "lint": "biome check",
    "ci": "npm run validate && npm run coverage && npm run lint && npm run check && npm test && npm run build && npm run examples:check && npm run eval",
    "examples:check": "tsx examples/task-board.ts > /dev/null && tsx examples/crm-contacts.ts > /dev/null && tsx examples/product-catalog.ts > /dev/null && tsx examples/invoice-dashboard.ts > /dev/null && echo 'all examples ran'"
  },
  "keywords": [
    "software-ontology",
    "compositional-code-generation",
    "llm",
    "coding-agents",
    "periodic-table",
    "reusability",
    "software-engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nulllabtests/software-periodic-table"
  },
  "bugs": {
    "url": "https://github.com/nulllabtests/software-periodic-table/issues"
  },
  "homepage": "https://github.com/nulllabtests/software-periodic-table#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "ontology",
    "atoms",
    "composer",
    "src",
    "docs",
    "CHANGELOG.md",
    "CITATION.cff",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./loader": {
      "types": "./dist/src/ontology.d.ts",
      "default": "./dist/src/ontology.js"
    },
    "./composer": {
      "types": "./dist/composer/prompt.d.ts",
      "default": "./dist/composer/prompt.js"
    },
    "./schema": {
      "types": "./dist/src/jsonschema.d.ts",
      "default": "./dist/src/jsonschema.js"
    },
    "./atoms/*.js": {
      "types": "./dist/atoms/*.d.ts",
      "default": "./dist/atoms/*.js"
    },
    "./atoms/*": {
      "types": "./dist/atoms/*.d.ts",
      "default": "./dist/atoms/*.js"
    },
    "./package.json": "./package.json"
  }
}
